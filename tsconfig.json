{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@autodev/office-render": [
        "./packages/office-render/src/index.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next/dev/types/**/*.ts",
    ".next-page-snapshots/types/**/*.ts",
    ".next-page-snapshots/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "target/**/*",
    "e2e/**/*",
    "tests/**/*",
    "**/__tests__/**/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "scripts/debug/**/*",
    "playwright.config.ts",
    "playwright.tauri.config.ts",
    "src/test/**/*",
    "src/app/_api_excluded/**/*",
    "src/app/_well-known_excluded/**/*",
    "src/core/platform/tauri-bridge.ts",
    "src/core/db/sqlite.ts",
    "src/core/db/sqlite-schema.ts",
    "src/core/db/sqlite-stores.ts",
    "apps/**/*"
  ]
}
